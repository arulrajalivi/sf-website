# Copy to .env.local (Next.js) / .env (Prisma CLI) and fill in real values.
# Never commit filled-in credentials — every value below is a secret.

# --- Database -----------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/sf_website?schema=public"

# --- Better Auth --------------------------------------------------------
# 32+ random bytes: `openssl rand -base64 32`
BETTER_AUTH_SECRET=""
# Public origin of the app. Must match the OAuth redirect origin registered
# with every provider below (the Obvious hosted URL in deployed environments).
BETTER_AUTH_URL="http://localhost:3000"

# --- Social sign-in providers ------------------------------------------
# Redirect URI for each provider: ${BETTER_AUTH_URL}/api/auth/callback/<provider>
# Provider ids: google | microsoft | github
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

AUTH_MICROSOFT_ID=""
AUTH_MICROSOFT_SECRET=""
# Entra ID tenant: a tenant GUID, or "common" for multi-tenant + personal accounts.
AUTH_MICROSOFT_TENANT_ID="common"

AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# --- Integration token encryption --------------------------------------
# Exactly 32 bytes, base64 or hex: `openssl rand -base64 32`
# Rotating this makes every stored provider token undecryptable — users would
# have to reconnect, so treat it as durable state, not a throwaway.
TOKEN_ENCRYPTION_KEY=""

# --- Integration providers ---------------------------------------------
# Redirect URI to register with each provider:
#   ${BETTER_AUTH_URL}/api/integrations/<jira|linear|notion>/callback
# A provider whose pair is blank renders as "Unavailable" instead of offering a
# Connect button that could only fail.

# Atlassian OAuth 2.0 (3LO) app, with the Jira API and offline_access enabled.
INTEGRATION_JIRA_CLIENT_ID=""
INTEGRATION_JIRA_CLIENT_SECRET=""

INTEGRATION_LINEAR_CLIENT_ID=""
INTEGRATION_LINEAR_CLIENT_SECRET=""

INTEGRATION_NOTION_CLIENT_ID=""
INTEGRATION_NOTION_CLIENT_SECRET=""

# Optional: overrides BETTER_AUTH_URL as the origin OAuth redirects are built
# from. Set it only when the integration callbacks live on a different origin.
# APP_URL=""
